{
  "name": "auth-oidc",
  "version": "0.1.0",
  "apiVersion": "1",
  "kind": "auth",
  "capabilities": ["network"],
  "permissions": {
    "networkHosts": ["idp.example.com"],
    "secrets": []
  },
  "config": {
    "issuer": "https://idp.example.com",
    "audience": "do-sift",
    "jwksUrl": "https://idp.example.com/.well-known/jwks.json",
    "tenantClaim": "tenant_id",
    "rolesClaim": "roles"
  },
  "entry": "./src/index.ts",
  "description": "Reference OIDC auth provider (#120): verifies bearer id tokens against the provider JWKS and maps verified claims to a tenant-scoped Principal."
}
