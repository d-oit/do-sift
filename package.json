{
  "name": "do-sift",
  "version": "0.1.0",
  "private": true,
  "description": "Research with receipts: a plugin-based, token-frugal web research engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "scripts": {
    "check:fast": "tsx scripts/check.ts --fast",
    "check": "tsx scripts/check.ts",
    "verify:fast": "npm run check:fast",
    "verify": "npm run check && npm run test:coverage",
    "policy": "tsx scripts/policy.ts",
    "skills:check": "tsx scripts/skills-check.ts",
    "eval:offline": "tsx scripts/eval.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "eval:e2e": "tsx scripts/eval-e2e.ts",
    "evals:degradation": "tsx scripts/evals-degradation.ts",
    "evals:dashboard": "tsx scripts/evals-dashboard.ts",
    "release:check": "tsx scripts/release-check.ts",
    "signals": "tsx scripts/dev-harness/cli.ts",
    "version:check": "tsx scripts/version-policy.ts",
    "sbom": "tsx scripts/sbom.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "report:export": "tsx scripts/export-report.ts",
    "report:offline": "tsx scripts/reports.ts",
    "providers:status": "tsx scripts/provider-status.ts",
    "bench:analytics": "tsx scripts/bench/analytics-bench.ts",
    "hooks:install": "tsx scripts/dev-harness/cli.ts hook install",
    "test": "vitest run && vitest run -c vitest.unit.config.ts",
    "build": "tsc -b tsconfig.build.json",
    "test:coverage": "vitest run --coverage && vitest run -c vitest.unit.config.ts"
  },
  "volta": {
    "node": "24.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
