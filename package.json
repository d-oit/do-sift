{
  "name": "do-sift",
  "version": "0.1.0",
  "private": true,
  "description": "Research with receipts: a plugin-based, token-frugal web research engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "scripts": {
    "check:fast": "tsx scripts/check.ts --fast",
    "check": "tsx scripts/check.ts",
    "policy": "tsx scripts/policy.ts",
    "skills:check": "tsx scripts/skills-check.ts",
    "eval:offline": "tsx scripts/eval.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "eval:e2e": "tsx scripts/eval-e2e.ts",
    "evals:degradation": "tsx scripts/evals-degradation.ts",
    "evals:dashboard": "tsx scripts/evals-dashboard.ts",
    "release:check": "tsx scripts/release-check.ts",
    "signals": "tsx scripts/dev-harness/cli.ts",
    "hooks:install": "tsx scripts/dev-harness/cli.ts hook install",
    "test": "vitest run",
    "build": "tsc -b tsconfig.build.json",
    "test:coverage": "vitest run --coverage"
  },
  "volta": {
    "node": "24.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
