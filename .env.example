# do-sift local quickstart (fixture providers, loopback dev bypass).
# Not loaded automatically: `set -a; . ./.env.example; set +a` then
# `npx tsx apps/server/src/index.ts`. Full reference: docs/deployment.md.

# Required: at least one owner id; the allowlist is never empty.
DO_SIFT_OWNERS=local-owner

# Required: search provider. `fixture` is offline and deterministic.
DO_SIFT_SEARCH_PROVIDER=fixture

# Storage (libSQL). Local file by default; remote Turso needs the gated setup.
DO_SIFT_DB_URL=file:do-sift.db
DO_SIFT_DB_MIGRATIONS_DIR=migrations

# Loopback-only dev bypass. Refused on non-loopback binds.
DO_SIFT_HOST=127.0.0.1
DO_SIFT_PORT=8080
DO_SIFT_DEV_BYPASS=1
DO_SIFT_DEV_OWNER=local-owner

# Optional. Leave unset to keep /api/answer returning 501 (search-only mode).
# DO_SIFT_MODEL_PROVIDER=fixture
# DO_SIFT_EMBEDDER=fastembed

# Live adapters are gated (plans/sources.md). Secrets are referenced by NAME only;
# the value is resolved by the host's secret resolver, never stored here.
# DO_SIFT_MODEL_PROVIDER=openai-compat
# DO_SIFT_MODEL_BASE_URL=http://localhost:11434/v1
# DO_SIFT_MODEL_ID=
# DO_SIFT_MODEL_API_KEY_SECRET=
